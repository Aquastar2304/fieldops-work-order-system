# Normalise text files in the repository to LF.
* text=auto eol=lf

# Scripts that CI executes on Linux must never pick up CRLF.
mvnw           text eol=lf
*.sh           text eol=lf
gradlew        text eol=lf

# Windows-only scripts keep CRLF.
*.cmd          text eol=crlf
*.bat          text eol=crlf

# Binary
*.jar          binary
*.png          binary
*.jpg          binary
*.ico          binary
